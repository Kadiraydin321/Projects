        # Registry operations        registry_frame = ttk.LabelFrame(tab, text="Registry Ayarları")        registry_frame.pack(fill=tk.X, padx=10, pady=5)        
        key_label = ttk.Label(registry_frame, text="Kayıt Anahtarı:")        key_label.grid(row=0, column=0, sticky=tk.W)        self.registry_key_entry = ttk.Entry(registry_frame, width=50)        self.registry_key_entry.grid(row=0, column=1, padx=5, pady=5)        
        value_label = ttk.Label(registry_frame, text="Değer:")        value_label.grid(row=1, column=0, sticky=tk.W)        self.registry_value_entry = ttk.Entry(registry_frame, width=50)        self.registry_value_entry.grid(row=1, column=1, padx=5, pady=5)        
        # Buttons        read_btn = ttk.Button(registry_frame, text="Oku", command=self.read_registry_key)        read_btn.grid(row=2, column=0, pady=5)        
        write_btn = ttk.Button(registry_frame, text="Yaz", command=self.write_registry_key)        write_btn.grid(row=2, column=1, pady=5, sticky=tk.W)        
    def create_audio_tab(self):        tab = ttk.Frame(self.notebook)        self.notebook.add(tab, text="Ses Kontrolleri")        
        # Audio controls        audio_frame = ttk.LabelFrame(tab, text="Ses Ayarları")        audio_frame.pack(fill=tk.X, padx=10, pady=5)        
        # Volume control        volume_label = ttk.Label(audio_frame, text="Ses Seviyesi:")        volume_label.grid(row=0, column=0, sticky=tk.W)        self.volume_scale = tk.Scale(audio_frame, from_=0, to=100, orient=tk.HORIZONTAL)        self.volume_scale.grid(row=0, column=1, padx=5, pady=5, sticky=tk.W)        
        set_volume_btn = ttk.Button(audio_frame, text="Ayarla", command=self.set_volume)        set_volume_btn.grid(row=0, column=2, padx=5, pady=5)        
        # Audio devices        device_label = ttk.Label(audio_frame, text="Ses Aygıtları:")        device_label.grid(row=1, column=0, sticky=tk.W)        self.device_listbox = tk.Listbox(audio_frame)        self.device_listbox.grid(row=1, column=1, padx=5, pady=5, sticky=tk.W)        
        # Refresh devices button        refresh_devices_btn = ttk.Button(audio_frame, text="Güncelle", command=self.refresh_audio_devices)        refresh_devices_btn.grid(row=1, column=2, padx=5, pady=5)        
        self.refresh_audio_devices()        
    def create_display_tab(self):        tab = ttk.Frame(self.notebook)        self.notebook.add(tab, text="Ekran Ayarları")        
        # Display controls        display_frame = ttk.LabelFrame(tab, text="Ekran Kontrolleri")        display_frame.pack(fill=tk.X, padx=10, pady=5)        
        # Brightness control        brightness_label = ttk.Label(display_frame, text="Parlaklık Seviyesi:")        brightness_label.grid(row=0, column=0, sticky=tk.W)        self.brightness_scale = tk.Scale(display_frame, from_=0, to=100, orient=tk.HORIZONTAL)        self.brightness_scale.grid(row=0, column=1, padx=5, pady=5, sticky=tk.W)        
        set_brightness_btn = ttk.Button(display_frame, text="Ayarla", command=self.set_brightness)        set_brightness_btn.grid(row=0, column=2, padx=5, pady=5)        
        # Resolution control        resolution_label = ttk.Label(display_frame, text="Çözünürlük:")        resolution_label.grid(row=1, column=0, sticky=tk.W)        self.resolution_var = tk.StringVar()        resolution_combo = ttk.Combobox(display_frame, textvariable=self.resolution_var)        resolution_combo.grid(row=1, column=1, padx=5, pady=5, sticky=tk.W)        # Add resolutions        resolutions = ["1024x768", "1280x720", "1366x768", "1920x1080"]        resolution_combo['values'] = resolutions        resolution_combo.set(resolutions[0])        
        set_resolution_btn = ttk.Button(display_frame, text="Ayarla", command=self.set_resolution)        set_resolution_btn.grid(row=1, column=2, padx=5, pady=5)        
    def update_system_info(self):        # CPU usage        cpu_percent = psutil.cpu_percent(interval=1)        self.cpu_var.set(f"{cpu_percent}%")        
        # Memory usage        memory = psutil.virtual_memory()        self.memory_var.set(f"{memory.percent}% ({memory.used // (10242)} MB / {memory.total // (10242)} MB)")        
        # Disk usage        disk = psutil.disk_usage('/')        self.disk_var.set(f"{disk.percent}% ({disk.used // (10242)} MB / {disk.total // (10242)} MB)")        
    def start_network_test(self):        try:            # This is a simplified network test using ping            result = subprocess.run(["ping", "-n", "1", "google.com"], capture_output=True, text=True, timeout=10)            if result.returncode == 0:                self.test_result_label.config(text="Bağlantı başarılı!")            else:                self.test_result_label.config(text="Bağlantı başarısız!")        except Exception as e:            self.test_result_label.config(text=f"Hata: {str(e)}")            
    def read_registry_key(self):        key_path = self.registry_key_entry.get().strip()        if key_path:            try:                import winreg                with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, key_path) as key:                    value_name = self.registry_value_entry.get().strip()                    if not value_name:                        value_name = None                    value, _ = winreg.QueryValueEx(key, value_name)                self.test_result_label.config(text=f"Değer: {value}")            except Exception as e:                self.test_result_label.config(text=f"Hata: {str(e)}")        else:            self.test_result_label.config(text="Lütfen anahtar yolu girin!")            
    def write_registry_key(self):        key_path = self.registry_key_entry.get().strip()        value_name = self.registry_value_entry.get().strip()        if key_path and value_name:            try:                import winreg                with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, key_path, 0, winreg.KEY_SET_VALUE) as key:                    winreg.SetValueEx(key, value_name, 0, winreg.REG_SZ, "test_value")                self.test_result_label.config(text="Kayıt başarıyla yapıldı!")            except Exception as e:                self.test_result_label.config(text=f"Hata: {str(e)}")        else:            self.test_result_label.config(text="Lütfen anahtar ve değer yolu girin!")            
    def set_volume(self):        volume = self.volume_scale.get()        try:            # Use PowerShell to set volume            subprocess.run(["powershell", f"(Get-WaveOut).Volume={volume/100}"], check=True)            self.test_result_label.config(text=f"Ses seviyesi ayarlandı: {volume}%")        except Exception as e:            self.test_result_label.config(text=f"Hata: {str(e)}")            
    def refresh_audio_devices(self):        self.device_listbox.delete(0, tk.END)        try:            # Use PowerShell to get audio devices            result = subprocess.run(["powershell", "-Command", "Get-WinAudioDevice"], 
                                   capture_output=True, text=True)            if result.returncode == 0:                devices = result.stdout.split('\n')                for device in devices:                    if device.strip():                        self.device_listbox.insert(tk.END, device.strip())            else:                self.test_result_label.config(text="Ses cihazları alınamadı!")        except Exception as e:            self.test_result_label.config(text=f"Hata: {str(e)}")            
    def set_brightness(self):        brightness = self.brightness_scale.get()        try:            # Use PowerShell to set brightness            subprocess.run(["powershell", f"Get-WmiObject -Class Win32_Brightness"],                          check=True)            self.test_result_label.config(text=f"Parlaklık ayarlandı: {brightness}%")        except Exception as e:            self.test_result_label.config(text=f"Hata: {str(e)}")            
    def set_resolution(self):        resolution = self.resolution_var.get()        try:            # Use PowerShell to set resolution            subprocess.run(["powershell", f"Set-DisplayResolution -Width {resolution.split('x')[0]} -Height {resolution.split('x')[1]}"],                          check=True)            self.test_result_label.config(text=f"Çözünürlük ayarlandı: {resolution}")        except Exception as e:            self.test_result_label.config(text=f"Hata: {str(e)}")    def run(self):        self.root.mainloop()if name == "main":    # Check if running on Windows    if sys.platform != "win32":        messagebox.showerror("Hata", "Bu uygulama sadece Windows'ta çalışabilir.")        sys.exit(1)    
    app = WindowsManager()    app.run()python# requirements.txtpsutil==5.8.0Bu Windows Yönetim Uygulaması şu özellikleri içerir:1. Sistem Bilgileri Sekmesi:   - CPU kullanımını gösterir   - Bellek kullanımını gösterir   - Disk kullanımını gösterir2. Ağ Bilgileri Sekmesi:   - Ağ hız testi başlatır (basitleştirilmiş)3. Windows Registry Sekmesi:   - Kayıt anahtarlarını okur   - Kayıt anahtarlarına değer yazar4. Ses Kontrolleri Sekmesi:   - Ses seviyesini ayarlar   - Ses aygıtlarını listeler5. Ekran Ayarları Sekmesi:   - Parlaklık seviyesini ayarlar   - Çözünürlüğü ayarlarBu uygulama için gerekli bağımlılıkları yüklemek için:bashpip install psutilUygulama şu anahtar özelliklere sahiptir:- Platform bağımsızlık kontrolü (sadece Windows'ta çalışır)- Sistem kaynak kullanımını izleme- Ağ bağlantısını test etme- Windows Registry işlemlerini yönetme- Ses ve ekran ayarlarını denetlemeBu yapı, ihtiyaç duyduğunuz özellikleri genişletebilecek şekilde yapılandırılmıştır. Örneğin daha gelişmiş ağ testi, daha fazla registry işlemi veya diğer Windows ayarlarını eklemek mümkün olur. 

Uygulama, Windows'da PowerShell komutları kullanarak birçok sistem yönetim işlevini yerine getirir. Bu, kullanıcıların uygulamanın kendisinden fazla güvenlik izni olmadan Windows sistemiyle etkileşime girmesine olanak tanır.
