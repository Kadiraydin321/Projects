<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_chapter_card"
    android:elevation="4dp"
    android:padding="18dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp">

    <TextView
        android:id="@+id/tvNovelItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Novel Adı"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNovelItemAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Yazar Bilgisi"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNovelItemSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TR"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_badge_red"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bölümler ➔"
            android:textColor="@color/crimson_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
