modules/system_monitor.pypython"""System Monitor Module====================This module provides functions to monitor system resources including:- CPU usage and temperature- RAM usage- Disk usage- NVIDIA GPU utilization, VRAM, and temperatureThe module uses psutil for general system stats and nvidia-ml-py for GPU monitoring."""import psutilimport timefrom typing import Dict, Any, Optionaltry:    import pynvml    NVML_AVAILABLE = Trueexcept ImportError:    NVML_AVAILABLE = Falsedef get_cpu_usage() -> float:    """Get current CPU usage percentage."""    return psutil.cpu_percent(interval=1)def get_cpu_temperature() -> Optional[float]:    """Get current CPU temperature in Celsius."""    try:        temps = psutil.sensors_temperatures()        if not temps:            return None        
        # Try to get temperature from common CPU sensors        cpu_temp = None        for name, entries in temps.items():            if 'cpu' in name.lower() or 'coretemp' in name.lower():                for entry in entries:                    if entry.current is not None:                        cpu_temp = entry.current                        break            if cpu_temp is not None:                break        
        return cpu_temp    except Exception:        return Nonedef get_ram_usage() -> Dict[str, Any]:    """Get current RAM usage statistics."""    ram = psutil.virtual_memory()    
    return {        'total': ram.total,        'available': ram.available,        'used': ram.used,        'percentage': ram.percent    }def get_disk_usage(path: str = '/') -> Dict[str, Any]:    """Get current disk usage statistics for a given path."""    disk = psutil.disk_usage(path)    
    return {        'total': disk.total,        'used': disk.used,        'free': disk.free,        'percentage': disk.percent    }def get_gpu_stats() -> Optional[Dict[str, Any]]:    """    Get NVIDIA GPU statistics including utilization, VRAM usage, and temperature.    
    Returns:        Dict with GPU info or None if NVML is not available or no GPUs found    """    if not NVML_AVAILABLE:        return None    
    try:        # Initialize NVML        pynvml.nvmlInit()        
        # Get device count        device_count = pynvml.nvmlDeviceGetCount()        
        if device_count == 0:            return None            
        gpu_info = []        
        for i in range(device_count):            handle = pynvml.nvmlDeviceGetHandleByIndex(i)            
            # Get GPU name            name = pynvml.nvmlDeviceGetName(handle)            
            # Get utilization            util = pynvml.nvmlDeviceGetUtilizationRates(handle)            
            # Get memory info            mem_info = pynvml.nvmlDeviceGetMemoryInfo(handle)            
            # Get temperature            temp = pynvml.nvmlDeviceGetTemperature(handle, pynvml.NVML_TEMPERATURE_GPU)            
            gpu_info.append({                'name': name,                'utilization': util.gpu,                'memory_utilization': util.memory,                'memory_used': mem_info.used,                'memory_total': mem_info.total,                'memory_free': mem_info.free,                'temperature': temp            })        
        return gpu_info    
    except Exception:        return Nonedef get_system_stats() -> Dict[str, Any]:    """    Get all system statistics in a single dictionary.    
    Returns:        Dictionary containing CPU, RAM, Disk, and GPU stats    """    stats = {        'cpu': {            'usage': get_cpu_usage(),            'temperature': get_cpu_temperature()        },        'ram': get_ram_usage(),        'disk': get_disk_usage(),        'gpu': get_gpu_stats()    }    
    return statsdef monitor_system(interval: float = 1.0) -> None:    """    Continuously monitor system resources.    
    Args:        interval (float): Time in seconds between updates    """    print("Starting system monitoring... Press Ctrl+C to stop.")    
    try:        while True:            stats = get_system_stats()            
            # Print CPU info            cpu = stats['cpu']            print(f"CPU Usage: {cpu['usage']:.1f}%")            if cpu['temperature']:                print(f"CPU Temperature: {cpu['temperature']:.1f}°C")            
            # Print RAM info            ram = stats['ram']            print(f"RAM Usage: {ram['used'] / (10243):.2f} GB / {ram['total'] / (10243):.2f} GB "                  f"({ram['percentage']:.1f}%)")            
            # Print Disk info            disk = stats['disk']            print(f"Disk Usage: {disk['used'] / (10243):.2f} GB / {disk['total'] / (10243):.2f} GB "                  f"({disk['percentage']:.1f}%)")            
            # Print GPU info            gpu = stats['gpu']            if gpu:                for i, g in enumerate(gpu):                    print(f"GPU {i} ({g['name']}): "                          f"Utilization: {g['utilization']}%, "                          f"Memory: {g['memory_used'] / (10243):.2f} GB / {g['memory_total'] / (10243):.2f} GB, "                          f"Temperature: {g['temperature']}°C")            
            print("-" * 80)            time.sleep(interval)    
    except KeyboardInterrupt:        print("\nMonitoring stopped.")# Example usageif name == "main":    # Get current stats    current_stats = get_system_stats()    print("Current System Stats:")    print(current_stats)    
    # Uncomment the following line to start continuous monitoring    # monitor_system()This module provides a comprehensive system monitoring solution with:1. CPU Monitoring:   - CPU usage percentage (get_cpu_usage)   - CPU temperature (get_cpu_temperature)2. Memory Monitoring:   - RAM usage statistics (get_ram_usage)3. Disk Monitoring:   - Disk usage for a given path (get_disk_usage)4. GPU Monitoring (NVIDIA only):   - GPU utilization percentage   - VRAM usage and total memory   - GPU temperature (get_gpu_stats)   
5. Combined System Stats:   - get_system_stats() function that aggregates all the information6. Continuous Monitoring:   - monitor_system() function to continuously display system stats with a configurable intervalThe module uses psutil for general system monitoring and pynvml (NVIDIA Management Library) for GPU-specific stats. It handles cases where NVML is not available or GPUs are not found, returning appropriate None values.Note: To run the GPU monitoring features, you'll need to install:bashpip install pynvml psutilUsage examples:- get_cpu_usage() - Get current CPU usage- get_ram_usage() - Get current RAM usage 
