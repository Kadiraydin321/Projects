import os
import sys
import subprocess
import psutil
import tkinter as tk
from tkinter import ttk, messagebox
import threading
import time

class WindowsManager:
    def init(self):
        self.root = tk.Tk()
        self.root.title("Windows Yönetim Aracı")
        self.root.geometry("800x700")
        self.setup_ui()

    def setup_ui(self):
        # Ana çerçeve
        main_frame = ttk.Frame(self.root, padding="10")
        main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))

        # Sistem bilgileri başlığı
        sys_info_label = ttk.Label(main_frame, text="Sistem Bilgileri", font=("Arial", 14, "bold"))
        sys_info_label.grid(row=0, column=0, columnspan=2, pady=(0, 10), sticky=tk.W)

        # Sistem bilgileri
        self.cpu_label = ttk.Label(main_frame, text="CPU: ", font=("Arial", 10))
        self.cpu_label.grid(row=1, column=0, sticky=tk.W, pady=2)
        self.memory_label = ttk.Label(main_frame, text="Bellek: ", font=("Arial", 10))
        self.memory_label.grid(row=2, column=0, sticky=tk.W, pady=2)
        self.disk_label = ttk.Label(main_frame, text="Disk: ", font=("Arial", 10))
        self.disk_label.grid(row=3, column=0, sticky=tk.W, pady=2)

        # Tarama butonu
        scan_button = ttk.Button(main_frame, text="Sistem Bilgilerini Güncelle", command=self.update_system_info)
        scan_button.grid(row=4, column=0, pady=(10, 20))

        # Görev Yöneticisi başlığı
        task_manager_label = ttk.Label(main_frame, text="Görev Yöneticisi", font=("Arial", 14, "bold"))
        task_manager_label.grid(row=5, column=0, columnspan=2, pady=(0, 10), sticky=tk.W)

        # Görev listesi
        self.task_listbox = tk.Listbox(main_frame, height=10)
