<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- ÜST NAVİGASYON ÇUBUĞU (Kırmızı-Beyaz-Siyah Modern Başlık) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark"
        android:elevation="6dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/crimson_red"
            android:visibility="gone"
            android:contentDescription="Geri" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 Moon Novel"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kişisel Kütüphanen • Çevrimdışı Okuyucu"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Gelişmiş Ayarlar & Tercihler Çark Butonu -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_gear"
            android:tint="@color/text_white"
            android:contentDescription="Uygulama Ayarları" />

        <!-- Grid / Liste Değiştirici Butonu -->
        <ImageButton
            android:id="@+id/btnToggleLayout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_dialog_dialer"
            android:tint="@color/crimson_light"
            android:visibility="gone"
            android:contentDescription="Görünüm Değiştir" />



        <!-- Arşiv Deposu Butonu -->
        <ImageButton
            android:id="@+id/btnLibrary"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@color/crimson_red"
            android:contentDescription="İndirilen Arşivler" />
    </LinearLayout>

    <!-- İÇERİK ALANI -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. ANA ARAMA VE NOVEL LİSTESİ EKRANI -->
        <LinearLayout
            android:id="@+id/viewSearchAndNovels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="18dp">

            <!-- Başlangıçta Ekranın Ortasında Duran, Arama Yapılınca Üste Kayan Arama Bölümü -->
            <LinearLayout
                android:id="@+id/heroSearchSection"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ne Okumak İstiyorsun?"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvHeroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anime veya novel adını yaz, saniyeler içinde keşfet."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Şık Yuvarlatılmış Arama Kutusu ve Keşfet Butonu -->
                <LinearLayout
                    android:id="@+id/searchContainer"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search_box"
                    android:elevation="6dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:tint="@color/text_muted" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Örn: Solo Leveling, Mushoku, Shadow Slave..."
                        android:textColorHint="@color/text_dark_muted"
                        android:textColor="@color/text_white"
                        android:background="@null"
                        android:paddingHorizontal="14dp"
                        android:textSize="15sp"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Keşfet"
                        android:background="@drawable/bg_btn_accent"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Modern Kaynak Seçim Chip Barı -->
            <LinearLayout
                android:id="@+id/sourceTabBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabSourceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🌐 Tümü (TR/EN)"
                    android:textColor="@color/text_white"
                    android:background="@drawable/bg_source_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabSourceTR"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🇹🇷 NovelGecesi"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_source_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabSourceEN"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🇺🇸 Wuxia / EN"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_source_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNovelsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bulunan Seriler:"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Boş Sonuç / Bulunamadı Espirili Durum Ekranı -->
            <LinearLayout
                android:id="@+id/emptySearchState"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(っ˘̩╭╮˘̩)っ"
                    android:textColor="@color/crimson_red"
                    android:textSize="36sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eyvah! Aradığın novel bulunamadı :("
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belki yazar henüz yazmamıştır ya da ismini yanlış yazmış olabilirsin.\nFarklı bir kelimeyle tekrar deneyelim mi? (◕‿◕✿)"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Novel Sonuç Listesi -->
            <ListView
                android:id="@+id/lvNovels"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@drawable/transparent_divider"
                android:dividerHeight="12dp"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="96dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. BÖLÜM EKRANI (LİSTE VEYA GRID DESTEKLİ + ANLIK BÖLÜM ARAMA VE SIRALAMA) -->
        <LinearLayout
            android:id="@+id/viewChapters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <!-- Bölüm İçi Hızlı Arama & Filtreleme Barı -->
            <LinearLayout
                android:id="@+id/chapterSearchBar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="@color/text_muted" />

                <EditText
                    android:id="@+id/etFilterChapters"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Bölüm ara (Örn: 25, Önsöz, Cilt 3)..."
                    android:textColorHint="@color/text_dark_muted"
                    android:textColor="@color/text_white"
                    android:background="@null"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/btnSortChapters"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="@color/crimson_light"
                    android:contentDescription="Sırala" />
            </LinearLayout>

            <!-- Liste Görünümü -->
            <ListView
                android:id="@+id/lvChapters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/transparent_divider"
                android:dividerHeight="10dp"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="96dp" />

            <!-- Grid (Izgara) Görünümü -->
            <GridView
                android:id="@+id/gvChapters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="2"
                android:verticalSpacing="12dp"
                android:horizontalSpacing="12dp"
                android:stretchMode="columnWidth"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="96dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. İNDİRİLEN ZİP VE ÇEVRİMDIŞI KÜTÜPHANE EKRANI -->
        <LinearLayout
            android:id="@+id/viewLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/emptyLibraryState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(っ˘ڡ˘ς)"
                    android:textColor="@color/crimson_light"
                    android:textSize="36sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Burası henüz bomboş!"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beğendiğin bir seriyi arayıp istediğin bölümü oku veya indir,\narşivinde saklansın! (づ｡◕‿‿◕｡)づ"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvDownloads"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/transparent_divider"
                android:dividerHeight="12dp"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="96dp" />
        </LinearLayout>

        <!-- Yükleme Çubuğu ve Durum Mesajı (Altta Şık Toast Kartı) -->
        <LinearLayout
            android:id="@+id/bottomStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="@drawable/bg_bottom_toast"
            android:padding="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:elevation="8dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateTint="@color/crimson_red"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:text="İşlem yapılıyor..." />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
