        # Create notebook for tabs        self.notebook = ttk.Notebook(self.root)        self.notebook.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)        
        # Create tabs        self.create_system_tab()        self.create_network_tab()        self.create_registry_tab()        self.create_audio_tab()        self.create_display_tab()        
    def create_system_tab(self):        tab = ttk.Frame(self.notebook)        self.notebook.add(tab, text="Sistem Bilgileri")        
        # System information        info_frame = ttk.LabelFrame(tab, text="Sistem Bilgileri")        info_frame.pack(fill=tk.X, padx=10, pady=5)        
        # CPU usage        cpu_label = ttk.Label(info_frame, text="CPU Kullanımı:")        cpu_label.grid(row=0, column=0, sticky=tk.W)        self.cpu_var = tk.StringVar()        cpu_value = ttk.Label(info_frame, textvariable=self.cpu_var)        cpu_value.grid(row=0, column=1, sticky=tk.W)        
        # Memory usage        memory_label = ttk.Label(info_frame, text="Bellek Kullanımı:")        memory_label.grid(row=1, column=0, sticky=tk.W)        self.memory_var = tk.StringVar()        memory_value = ttk.Label(info_frame, textvariable=self.memory_var)        memory_value.grid(row=1, column=1, sticky=tk.W)        
        # Disk usage        disk_label = ttk.Label(info_frame, text="Disk Kullanımı:")        disk_label.grid(row=2, column=0, sticky=tk.W)        self.disk_var = tk.StringVar()        disk_value = ttk.Label(info_frame, textvariable=self.disk_var)        disk_value.grid(row=2, column=1, sticky=tk.W)        
        # Refresh button        refresh_btn = ttk.Button(tab, text="Güncelle", command=self.update_system_info)        refresh_btn.pack(pady=5)        
        self.update_system_info()        
    def create_network_tab(self):        tab = ttk.Frame(self.notebook)        self.notebook.add(tab, text="Ağ Bilgileri")        
        # Network speed test        network_frame = ttk.LabelFrame(tab, text="Ağ Hız Testi")        network_frame.pack(fill=tk.X, padx=10, pady=5)        
        start_test_btn = ttk.Button(network_frame, text="Hız Testi Başlat", command=self.start_network_test)        start_test_btn.pack(pady=5)        
        self.test_result_label = ttk.Label(network_frame, text="")        self.test_result_label.pack(pady=5)        
