<Window x:Class="WindowsManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Management App" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Windows System Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CPU:" FontWeight="Bold"/>
                    <TextBlock Name="txtCPU" Margin="0,5,0,10"/>
                    
                    <TextBlock Text="RAM:" FontWeight="Bold"/>
                    <TextBlock Name="txtRAM" Margin="0,5,0,10"/>
                    
                    <TextBlock Text="OS Version:" FontWeight="Bold"/>
                    <TextBlock Name="txtOS" Margin="0,5,0,10"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total Disk Space:" FontWeight="Bold"/>
                    <TextBlock Name="txtDisk" Margin="0,5,0,10"/>
                    
                    <TextBlock Text="Network Status:" FontWeight="Bold"/>
                    <TextBlock Name="txtNetwork" Margin="0,5,0,10"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Test Network Speed" Name="btnTestSpeed" Width="150" Height="30" Margin="5" Click="btnTestSpeed_Click"/>
                <Button Content="Registry Settings" Name="btnRegistry" Width="150" Height="30" Margin="5" Click="btnRegistry_Click"/>
                <Button Content="Adjust Brightness" Name="btnBrightness" Width="150" Height="30" Margin="5" Click="btnBrightness_Click"/>
                <Button Content="Control Volume" Name="btnVolume" Width="150" Height="30" Margin="5" Click="btnVolume_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>