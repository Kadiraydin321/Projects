    def update_system_info(self):
        try:
            # CPU kullanımı
            cpu_percent = psutil.cpu_percent(interval=1)
            self.cpu_label.config(text=f"CPU: {cpu_percent}%")
            
            # Bellek kullanımı
            memory = psutil.virtual_memory()
            memory_percent = memory.percent
            self.memory_label.config(text=f"Bellek: {memory_percent}% ({memory.used // (10242)} MB / {memory.total // (10242)} MB)")
            
            # Disk kullanımı
            disk = psutil.disk_usage('/')
            disk_percent = (disk.used / disk.total) * 100
            self.disk_label.config(text=f"Disk: {disk_percent:.1f}% ({disk.used // (10243)} GB / {disk.total // (10243)} GB)")
            
        except Exception as e:
            messagebox.showerror("Hata", f"Sistem bilgileri alınırken hata oluştu: {str(e)}")

    def refresh_tasks(self):
        try:
            self.task_listbox.delete(0, tk.END)
            for proc in psutil.process_iter(['pid', 'name']):
                try:
                    # Sadece çalışan süreçleri listele
                    if proc.info['name'] is not None and len(proc.info['name']) > 0:
                        self.task_listbox.insert(tk.END, f"{proc.info['name']} (PID: {proc.info['pid']})")
                except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
                    pass
        except Exception as e:
            messagebox.showerror("Hata", f"Görevler alınırken hata oluştu: {str(e)}")

    def on_task_double_click(self, event):
        self.kill_task()

    def kill_task(self):
        try:
            selection = self.task_listbox.curselection()
            if selection:
                task_info = self.task_listbox.get(selection[0])
                pid = int(task_info.split('PID: ')[1].split(')')[0])
                psutil.Process(pid).terminate()
                messagebox.showinfo("Başarılı", "Görev başarıyla sonlandırıldı")
                self.refresh_tasks()
        except Exception as e:
            messagebox.showerror("Hata", f"Görev sonlandırılırken hata oluştu: {str(e)}")

    def test_network_connection(self):
        try:
            self.network_result.delete(1.0, tk.END)
            result = "Bağlantı Testi Sonuçları:\n"
            result += "-" * 40 + "\n"
            result += f"Ping Testi: www.google.com\n" + "=" * 40 + "\n"
            try:
                # Ping testi için psutil kullanmayalım, ping komutunu direkt çağır
                import subprocess
                result += "Ping yapılmaya çalışılıyor...\n"
                self.network_result.insert(tk.END, result)
                self.network_result.see(tk.END)
                self.network_result.update()
            except Exception as ping_error:
                result += f"Ping hatası: {str(ping_error)}\n"
        except Exception as e:
            messagebox.showerror("Hata", f"Ağ testi yapılırken hata oluştu: {str(e)}")

    def test_internet_speed(self):
        # Hız testi için hız ölçme fonksiyonu çağrılacak
        self.network_result.delete(1.0, tk.END)
        self.network_result.insert(tk.END, "Hız testi başlatılıyor...\n")
        self.network_result.insert(tk.END, "Bu işlem biraz zaman alabilir.\n")
        self.network_result.see(tk.END)

    def open_registry(self):
        try:
            registry_path = self.registry_entry.get().strip()
            if registry_path:
                # Registry'yi açma
                import subprocess
                subprocess.run(["regedit", registry_path])
            else:
                messagebox.showwarning("Uyarı", "Lütfen geçerli bir kayıt defteri yolu girin")
        except Exception as e:
            messagebox.showerror("Hata", f"Kayıt defteri açılırken hata oluştu: {str(e)}")

    def list_registry_keys(self):
        try:
            registry_path = self.registry_entry.get().strip()
            if registry_path:
                # Registry anahtarlarını sorgulama
                import subprocess
                process = subprocess.Popen(["reg", "query", registry_path], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                output, error = process.communicate()
                result = f"Kayıt defteri anahtarı bilgileri:\n{output.decode('utf-8') if output else 'Anahtar bulunamadı'}\n"
                self.network_result.delete(1.0, tk.END)
                self.network_result.insert(tk.END, result)
            else:
                messagebox.showwarning("Uyarı", "Lütfen geçerli bir kayıt defteri yolu girin")
        except Exception as e:
            messagebox.showerror("Hata", f"Kayıt defteri sorgulanırken hata oluştu: {str(e)}")

    def set_volume(self):
        try:
            volume = self.volume_scale.get()
            # Ses ayarı için komut veya API
            messagebox.showinfo("Bilgi", f"Ses düzeyi {volume}% olarak ayarlandı")
        except Exception as e:
            messagebox.showerror("Hata", f"Ses ayarlanırken hata oluştu: {str(e)}")

    def set_brightness(self):
        try:
            brightness = self.brightness_scale.get()
            # Parlaklık ayarı için komut veya API
            messagebox.showinfo("Bilgi", f"Parlaklık düzeyi {brightness}% olarak ayarlandı")
        except Exception as e:
            messagebox.showerror("Hata", f"Parlaklık ayarlanırken hata oluştu: {str(e)}")

    def execute_command(self):
        try:
            command = self.command_entry.get().strip()
            if command:
                import subprocess
                result = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=30)
                output_text = f"Komut: {command}\n"
                output_text += "="*50 + "\n"
                output_text += "Çıktı:\n"
                output_text += result.stdout
                if result.stderr:
                    output_text += "Hata:\n"
                    output_text += result.stderr
                output_text += "-"*50 + "\n"
                self.command_output.delete(1.0, tk.END)
                self.command_output.insert(tk.END, output_text)
                self.command_entry.delete(0, tk.END)
            else:
                messagebox.showwarning("Uyarı", "Lütfen bir komut girin")
        except subprocess.TimeoutExpired:
            messagebox.showerror("Hata", "Komut zaman aşımına uğradı")
        except Exception as e:
            messagebox.showerror("Hata", f"Komut çalıştırılırken hata oluştu: {str(e)}")

