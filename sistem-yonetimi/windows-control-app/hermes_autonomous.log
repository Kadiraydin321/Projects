İlk adım olarak, uygulamanın ana bileşenlerini içeren bir temel kod yazalım.---## 🔧 Uygulama Yapısı:plaintextwindows_admin_tool/├── main.py                # Ana uygulama├── utils/│   ├── network.py         # Ağ hız testi fonksiyonları│   ├── registry.py        # Windows Registry ile etkileşim│   └── audio_brightness.py # Ses ve parlaklık kontrolü├── tests/│   ├── test_network.py│   ├── test_registry.py│   └── test_audio_brightness.py└── requirements.txt       # Gerekli kütüphaneler---## 📦 requirements.txttxtrequestspywin32psutiltkinterpytest---## 🧠 Ana Uygulama Dosyası: main.pypythonimport tkinter as tkfrom tkinter import ttkfrom utils.network import test_network_speedfrom utils.registry import read_registry_key, write_registry_keyfrom utils.audio_brightness import set_volume, get_brightnessclass WindowsAdminApp:    def init(self, root):        self.root = root        self.root.title("Windows Yönetim Aracı")        self.root.geometry("500x400")        # Menü        menu_frame = ttk.Frame(root)        menu_frame.pack(pady=10)        ttk.Button(menu_frame, text="Ağ Hız Testi", command=self.network_test).pack(pady=5)        ttk.Button(menu_frame, text="Registry Oku", command=self.read_registry).pack(pady=5)        ttk.Button(menu_frame, text="Registry Yaz", command=self.write_registry).pack(pady=5)        ttk.Button(menu_frame, text="Ses Ayarla", command=self.set_volume).pack(pady=5)        ttk.Button(menu_frame, text="Parlaklık Ayarla", command=self.set_brightness).pack(pady=5)        # Sonuç alanı        self.result_text = tk.Text(root, height=15, width=60)        self.result_text.pack(pady=10)    def network_test(self):        try:            speed = test_network_speed()            self.result_text.insert(tk.END, f"Ağ Hızı: {speed}\n")        except Exception as e:            self.result_text.insert(tk.END, f"Hata: {str(e)}\n")    def read_registry(self):        try:            key = "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion"            value = read_registry_key(key)            self.result_text.insert(tk.END, f"Registry değeri: {value}\n")        except Exception as e:            self.result_text.insert(tk.END, f"Hata: {str(e)}\n")    def write_registry(self):        try:            key = "HKEY_CURRENT_USER\\Software\\TestKey"            value = "TestValue"            write_registry_key(key, value)            self.result_text.insert(tk.END, f"Registry yazıldı: {key} -> {value}\n")        except Exception as e:            self.result_text.insert(tk.END, f"Hata: {str(e)}\n")    def set_volume(self):        try:            volume = 50            set_volume(volume)            self.result_text.insert(tk.END, f"Ses seviyesi ayarlandı: {volume}%\n")        except Exception as e:            self.result_text.insert(tk.END, f"Hata: {str(e)}\n")    def set_brightness(self):        try:            brightness = 70            get_brightness(brightness)            self.result_text.insert(tk.END, f"Parlaklık seviyesi ayarlandı: {brightness}%\n")        except Exception as e:            self.result_text.insert(tk.END, f"Hata: {str(e)}\n")if name == "main":    root = tk.Tk()    app = WindowsAdminApp(root)    root.mainloop()---## 🌐 utils/network.pypythonimport requestsimport timedef test_network_speed():    start_time = time.time()    try:        response = requests.get("https://httpbin.org/bytes/102400", timeout=5)        end_time = time.time()        size = len(response.content)        duration = end_time - start_time        speed_kbps = (size / 1024) / duration        return f"{speed_kbps:.2f} KB/s"    except Exception as e:        return f"Hata: {e}"---## 🧰 utils/registry.pypythonimport winregdef read_registry_key(key_path):    try:        path, name = key_path.rsplit("\\", 1)        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, path) as key:            value, _ = winreg.QueryValueEx(key, name)            return value    except Exception as e:        raise Exception(f"Registry okuma hatası: {e}")def write_registry_key(key_path, value):    try:        path, name = key_path.rsplit("\\", 1)        with winreg.CreateKey(winreg.HKEY_CURRENT_USER, path) as key:            winreg.SetValueEx(key, name, 0, winreg.REG_SZ, value)    except Exception as e:        raise Exception(f"Registry yazma hatası: {e}")---## 🔊 utils/audio_brightness.pypythonimport ctypesfrom ctypes import wintypesdef set_volume(level):    # Ses seviyesini ayarlar (0-100 arası)    ctypes.windll.user32.SendMessageW(0xFFFF, 0x0319, 0, level)def get_brightness(level):    # Parlaklık seviyesini ayarlar (0-100 arası)    ctypes.windll.dxgi.SetBrightness(0, level)---## 🧪 tests/test_network.pypythonimport unittestfrom utils.network import test_network_speedclass TestNetwork(unittest.TestCase):    def test_network_speed(self):        speed = test_network_speed()        self.assertIn("KB/s", speed)---## 🧪 tests/test_registry.pypythonimport unittestfrom utils.registry import read_registry_key, write_registry_keyclass TestRegistry(unittest.TestCase):    def test_registry_read_write(self):        try:            key = "HKEY_CURRENT_USER\\Software\\TestKey"            value = "TestValue"            write_registry_key(key, value)            retrieved = read_registry_key(key)            self.assertEqual(retrieved, value)        except Exception as e:            self.fail(f"Registry testi başarısız: {e}")---## 🧪 tests/test_audio_brightness.pypythonimport unittestfrom utils.audio_brightness import set_volumeclass TestAudioBrightness(unittest.TestCase):    def test_volume_setting(self):        try:            set_volume(50)            self.assertTrue(True)  # Basit kontrol        except Exception as e:            self.fail(f"Ses ayarı hatası: {e}")---### ✅ Kullanım Talimatları1. Gerekli paketleri yükleyin:bashpip install -r requirements.txt2. Uygulamayı çalıştırın:bashpython main.py3. Testleri çalıştırın:bashpytest tests/---### 🧩 Notlar:- utils/audio_brightness.py örnek koddur ve tam olarak çalışmaması durumunda, Windows API'leriyle uyumlu düzeltme yapılabilir.- Daha ileri düzey testler ve GUI düzeltmeleri için daha karmaşık yapılar eklenebilir.Hazır olduğunda, bu uygulamayı geliştirip daha güçlü hale getirebilirim. İsterseniz bir test süreci, bir modüler arayüz tasarımı, veya bir GUI özelleştirme gibi konularda ilerleyebiliriz.Yardımcı olmamı ister misin?
