<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_dark_bg"
    android:fitsSystemWindows="true">

    <!-- 1. GERÇEK SAYFALAMA: ViewPager2 (Yatay Moon+ Reader Sayfa Çevirme) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerReader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="58dp"
        android:paddingBottom="58dp"
        android:clipToPadding="false" />

    <!-- 2. ÜST BİLGİ & KONTROL ÇUBUĞU (Dokunmayla Açılır/Kapanır) -->
    <LinearLayout
        android:id="@+id/readerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F20D0D11"
        android:elevation="10dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btnReaderBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/crimson_red"
            android:contentDescription="Geri" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tvReaderNovelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novel Adı"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvReaderChapterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bölüm 1: Giriş"
                android:textColor="@color/crimson_light"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Otomatik Çeviri Butonu (EN -> TR) -->
        <Button
            android:id="@+id/btnTranslateChapter"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="TR Çevir"
            android:background="@drawable/bg_btn_accent"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="6dp" />

        <!-- Sesli Okuma (TTS) Aç/Kapa Butonu -->
        <ImageButton
            android:id="@+id/btnToggleTtsPanel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_volume_up"
            android:tint="@color/crimson_light"
            android:contentDescription="Sesli Okuma (TTS)" />
    </LinearLayout>

    <!-- 3. ALT KONTROL ALANI (Tek, Çakışmasız, Modern Kapsayıcı) -->
    <FrameLayout
        android:id="@+id/readerBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="14dp"
        android:animateLayoutChanges="true">

        <!-- 3A. STANDART OKUYUCU ALT BARI (Sayfa No, Tema, Yazı Boyutu, Hızlı TTS) -->
        <LinearLayout
            android:id="@+id/readerBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F20D0D11"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvReaderPageIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sayfa 1 / 1"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!-- Hızlı Sesli Oku Butonu -->
                <TextView
                    android:id="@+id/btnQuickStartTts"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🔊 Dinle"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_accent"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="10dp" />

                <!-- 6 Tema Seçici: 3 Karanlık (Obsidyen, AMOLED, Gece Mavisi) + 3 Aydınlık (Sepya, Beyaz, Nane) -->
                <TextView
                    android:id="@+id/btnThemeDark"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="#0A0A0C"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/btnThemeAmoled"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="#000000"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/btnThemeMidnight"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="#0B132B"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/btnThemeSepia"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="#F4ECD8"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/btnThemeLightWhite"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="#FFFFFF"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/btnThemeMint"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="#EDF6F0"
                    android:layout_marginEnd="8dp" />

                <!-- Font Boyut Butonları -->
                <TextView
                    android:id="@+id/btnFontSmaller"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="A-"
                    android:textColor="@color/text_white"
                    android:gravity="center"
                    android:background="@drawable/bg_chapter_card"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnFontBigger"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="A+"
                    android:textColor="@color/text_white"
                    android:gravity="center"
                    android:background="@drawable/bg_chapter_card" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3B. YENİLENMİŞ ŞIK SESLİ OKUMA (TTS) KONTROL PANELİ -->
        <LinearLayout
            android:id="@+id/ttsControlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tts_panel"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Panel Üst Çubuğu: İkon, Başlık, İlerleme Rozeti, Ses Seçici, Kapat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_up"
                    android:tint="@color/crimson_red"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sesli Okuma"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTtsSentenceCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="• Cümle 1 / 1"
                    android:textColor="@color/crimson_light"
                    android:textSize="11sp"
                    android:paddingStart="6dp" />

                <!-- Ses Profili Seçme Butonu -->
                <Button
                    android:id="@+id/btnTtsVoiceProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🎧 Ses Seç"
                    android:background="@drawable/bg_chapter_card"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnTtsClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/text_muted"
                    android:contentDescription="Kapat" />
            </LinearLayout>

            <!-- Okunan Cümle Önizleme Kartı (Sıkıştırmasız, Okunaklı) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tts_sentence_card"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvTtsCurrentSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sesli okuma hazır..."
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Cümle İlerleme SeekBar'ı (Moon+ Reader Tarzı Kaydırmalı Arama) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvTtsProgressStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/sbTtsProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="@color/crimson_red"
                    android:thumbTint="@color/crimson_light"
                    android:max="100"
                    android:progress="0"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/tvTtsProgressEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Oynatma Kontrolleri (Geri Sar, Oynat/Duraklat, İleri Sar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <ImageButton
                    android:id="@+id/btnTtsPrev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="@color/crimson_light"
                    android:contentDescription="Önceki Cümle" />

                <ImageButton
                    android:id="@+id/btnTtsPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_tts_play_btn"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/text_white"
                    android:contentDescription="Oynat/Duraklat"
                    android:layout_marginHorizontal="28dp"
                    android:elevation="6dp" />

                <ImageButton
                    android:id="@+id/btnTtsNext"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/crimson_light"
                    android:contentDescription="Sonraki Cümle" />
            </LinearLayout>

            <!-- Hız Seçenekleri (Modern Şık Chip Dizilimi) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hız:"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnTtsSpeed08"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.8x"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_tts_chip_inactive"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnTtsSpeed10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="@color/text_white"
                    android:background="@drawable/bg_tts_chip_active"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnTtsSpeed12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2x"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_tts_chip_inactive"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnTtsSpeed15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.5x"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_tts_chip_inactive"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnTtsSpeed20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.0x"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_tts_chip_inactive"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Ses Tonu (Pitch) Seçenekleri (Kalın, Normal, İnce) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ton:"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnTtsPitchLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kalın"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_tts_chip_inactive"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnTtsPitchNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doğal"
                    android:textColor="@color/text_white"
                    android:background="@drawable/bg_tts_chip_active"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnTtsPitchHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İnce"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_tts_chip_inactive"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
